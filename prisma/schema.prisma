generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ TENANTS ============

model Tenant {
  id                    String   @id @default(cuid())
  slug                  String   @unique // url slug, e.g. "wraplab"
  name                  String
  logo                  String   @default("")
  tagline               String   @default("")
  primaryColor          String   @default("#d7b51a")
  secondaryColor        String   @default("#333333")
  phone                 String   @default("")
  email                 String   @default("")
  address               String   @default("")
  whatsapp              String   @default("")
  deliveryFee           Int      @default(150)
  freeDeliveryThreshold Int      @default(1500)
  currency              String   @default("Rs.")
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users       User[]
  categories  Category[]
  products    Product[]
  productAddons ProductAddon[]
  cartItems   CartItem[]
  orders      Order[]
  orderItems  OrderItem[]
  offers      Offer[]
}

// ============ USERS & AUTH ============

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String
  phone        String?
  passwordHash String
  address      String?
  role         String   @default("customer") // customer | admin
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Session {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// ============ CATALOG ============

model Category {
  id        Int      @id @default(autoincrement())
  tenantId  String
  name      String
  icon      String   @default("🍽️")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id          Int      @id @default(autoincrement())
  tenantId    String
  name        String
  description String
  price       Int      // stored in PKR (Rs.)
  image       String   @default("")
  categoryId  Int
  badge       String?  // Bestseller, New, Popular, Premium, Veg, Save 20%
  rating      Float    @default(4.0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category       @relation(fields: [categoryId], references: [id])
  addons     ProductAddon[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([tenantId])
}

model ProductAddon {
  id        Int    @id @default(autoincrement())
  tenantId  String
  name      String
  price     Int    // addon price in PKR
  productId Int

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, name])
  @@index([tenantId])
}

// ============ CART ============

model CartItem {
  id        Int      @id @default(autoincrement())
  tenantId  String
  userId    String
  productId Int
  quantity  Int      @default(1)
  addons    String?  // JSON array of selected addon names, e.g. '["Extra Cheese"]'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([tenantId])
}

// ============ ORDERS ============

model Order {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  orderNumber   String   @unique // human-readable, e.g. WL-20260816-001
  status        String   @default("pending") // pending | confirmed | preparing | delivered | cancelled
  paymentMethod String   @default("cod") // cod | card
  customerName  String
  customerPhone String
  deliveryAddr  String
  notes         String?
  subtotal      Int      // in PKR
  deliveryFee   Int      @default(150)
  discountCode  String?
  discountAmt   Int      @default(0)
  total         Int      // in PKR
  estimatedMin  Int      @default(35) // estimated delivery minutes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([userId])
  @@index([tenantId])
}

model OrderItem {
  id           Int    @id @default(autoincrement())
  tenantId     String
  orderId      String
  productId    Int
  productName  String // denormalized for historical accuracy
  productPrice Int    // price at time of order
  quantity     Int
  addons       String? // JSON array
  lineTotal    Int    // productPrice * quantity + addon prices

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId])
}

// ============ OFFERS / COUPONS ============

model Offer {
  id            Int       @id @default(autoincrement())
  tenantId      String
  title         String
  description   String
  code          String
  icon          String    @default("🎁")
  discountType  String    @default("percentage") // percentage | flat | free_delivery
  discountValue Int       @default(0) // percentage value or flat amount
  minOrder      Int       @default(0) // minimum order amount to apply
  isActive      Boolean   @default(true)
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}